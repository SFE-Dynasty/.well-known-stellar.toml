{
  "name": "CLEARING-ROUTEP‚€ ÂÓa`Ë “† Ícr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [8000, 2022, 8090],
  "portsAttributes": {
    "8000": {
      "label": "ENGINE-CORE (Fiduciary Clearing Engine)",
      "onAutoForward": "notify"
    },
    "2022": {
      "label": "SFTPGO-ROUTER (SFTP)",
      "onAutoForward": "notify"
    },
    "8090": {
      "label": "SFTPGO-ROUTER (REST API)",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "pip install -r requirements.txt && docker pull drakkan/sftpgo:latest",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.profiles.linux": {
          "ENGINE-CORE": {
            "path": "bash",
            "args": ["-c", "echo '=== ENGINE-CORE ===' && echo 'Starting Fiduciary Clearing Engine on port 8000...' && uvicorn main:app --host 0.0.0.0 --port 8000 --reload"],
            "icon": "server"
          },
          "SFTPGO-ROUTER": {
            "path": "bash",
            "args": ["-c", "echo '=== SFTPGO-ROUTER ===' && echo 'Starting SFTPGo on port 2022 (SFTP) and 8090 (REST API)...' && docker run --rm -p 2022:2022 -p 8090:8080 --name sftpgo-router drakkan/sftpgo:latest"],
            "icon": "plug"
          }
        },
        "terminal.integrated.defaultProfile.linux": "ENGINE-CORE"
      }
    }
  },
  "remoteEnv":{
    "STELLAR_NETWORK": "public",
    "STELLAR_HORIZON_URL": "https://horizon.stellar.org",
    "STELLAR_NETWORK_PASSPHRASE": "Public Global Stellar Network ; September 2015",
    "CLOB_COLD_ISSUER": "GCVDS4YYXQVFVVG4HSIBZAHQJAGMQUM6ZTJHUOQGEZHEV4VN2CX5SAT3",
    "SFETREAS_ISSUER": "GCLFWV2RMDZYNAMUCBH54U43DP3MWGCIVOH6SK6F4SVMYYR3CQSLKOP",
    "EXECUTOR_PUBLIC": "GCHQWVJ56MQNWSDAQÓEQ74WIT76VCCDYLWOWATGGD7SNMCZIQOCEHML",
    "HOME_DOMAIN": "sfe-dynasty.github.io",
    "CLEARING_ENGINE_URL": "https://fiduciary-clearing-engine.onrender.com",
    "SFTPGO_PORT_SFTP": "2022",
    "SFTPGO_PORT_REST": "8090",
    "DTI_PLACEHOLDER": "BGP5VXJME",
    "DTI_FIELD": "NACHA_INDIVIDUAL_IDENTIFICATION_NUMBER",
    "FRAMEWORK": "USSFE-PFIA-2025-T1A01",
    "SETTLEMENT_TX": "65947e881619d0374c69a25481665f05f9e0d59e84cf79438961ed5bfefdd58b",
